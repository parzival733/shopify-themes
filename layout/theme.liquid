<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title }} — {{ shop.name }}</title><link rel="canonical" href="{{ canonical_url }}">{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<meta property="og:title" content="{{ page_title | escape }}">{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}{{ 'base.css' | asset_url | stylesheet_tag }}<style>:root{--background:{{ settings.background }};--foreground:{{ settings.foreground }};--accent:{{ settings.accent }};--radius:{{ settings.radius }}px;--max:{{ settings.width }}px}</style><script>window.themeRoutes={add:{{ routes.cart_add_url | json }},cart:{{ routes.cart_url | json }},change:{{ routes.cart_change_url | json }},predictive:{{ routes.predictive_search_url | json }}};</script><script src="{{ 'theme.js' | asset_url }}" defer></script>{{ content_for_header }}</head><body><a class="skip" href="#MainContent">Skip to content</a>{% sections 'header-group' %}<main id="MainContent">{{ content_for_layout }}</main>{% sections 'footer-group' %}{% render 'cart-drawer' %}</body></html>