<section class="hero{% if section.settings.image %} has-image{% endif %}">{% if section.settings.image %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400', sizes: '100vw' }}<div class="overlay"></div>{% endif %}<div class="container"><div class="content"><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a></div></div></section>{% schema %}{"name":"Hero","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Everyday, elevated."},{"type":"textarea","id":"text","label":"Description","default":"A considered collection for the way you live."},{"type":"text","id":"button","label":"Button","default":"Shop now"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Hero"}]}{% endschema %}