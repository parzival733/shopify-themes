<section class="section" style="background:#f3f2f0"><div class="container" style="max-width:800px;text-align:center"><h2>{{ section.settings.heading | escape }}</h2>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email</label><input id="NewsletterEmail" class="input" name="contact[email]" type="email" required placeholder="Your email"><button class="button">Subscribe</button>{% if form.posted_successfully? %}<p>Thank you!</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div></section>{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Stay in touch"}],"presets":[{"name":"Newsletter"}]}{% endschema %}