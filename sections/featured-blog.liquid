<section class="section"><div class="container"><h2>{{ section.settings.heading | escape }}</h2><div class="grid">{% if section.settings.blog != blank %}{% for article in section.settings.blog.articles limit: section.settings.limit %}<article class="card">{% if article.image %}<a class="card-media" href="{{ article.url }}">{{ article.image | image_url: width: 850 | image_tag: loading: 'lazy', widths: '360,540,750,850' }}</a>{% endif %}<h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p><a href="{{ article.url }}">Read more</a></article>{% endfor %}{% endif %}</div></div></section>{% schema %}{"name":"Featured blog","settings":[{"type":"text","id":"heading","label":"Heading","default":"Journal"},{"type":"blog","id":"blog","label":"Blog"},{"type":"range","id":"limit","label":"Articles","min":2,"max":6,"step":1,"default":3}],"presets":[{"name":"Featured blog"}]}{% endschema %}