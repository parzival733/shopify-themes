<footer class="footer"><div class="container footer-grid"><div><h2>{{ shop.name }}</h2><p>{{ section.settings.text | escape }}</p></div><div><h3>Information</h3><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></div><div><h3>Newsletter</h3>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="FooterEmail" class="visually-hidden">Email</label><input id="FooterEmail" class="input" name="contact[email]" type="email" autocomplete="email" required placeholder="Email address"><button class="button" type="submit">Subscribe</button>{% if form.posted_successfully? %}<p>Thank you for subscribing.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</div></div><div class="container"><hr><small>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}</small>{% form 'localization' %}<label for="Country">Country</label><select id="Country" name="country_code" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select><label for="Language">Language</label><select id="Language" name="locale_code" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endform %}</div></footer>{% schema %}{"name":"Footer","settings":[{"type":"textarea","id":"text","label":"Description","default":"Thoughtful essentials for everyday life."},{"type":"link_list","id":"menu","label":"Legal and footer links","default":"footer"}]}{% endschema %}