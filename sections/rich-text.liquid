<section class="section"><div class="container" style="max-width:850px;text-align:center"><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'button' %}<a class="button" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endcase %}{% endfor %}</div></section>{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"heading","label":"Heading","default":"Made for living"},{"type":"richtext","id":"text","label":"Text","default":"<p>Quality and simplicity for every category.</p>"}],"blocks":[{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Text","default":"Explore"},{"type":"url","id":"link","label":"Link"}]},{"type":"@app"}],"presets":[{"name":"Rich text"}]}{% endschema %}