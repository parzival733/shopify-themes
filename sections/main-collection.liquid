<section class="section"><div class="container"><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div>{% paginate collection.products by section.settings.per_page %}<div class="filterbar"><span>{{ collection.products_count }} products</span><form><label for="Sort">Sort by</label><select class="input" id="Sort" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% if section.settings.filters %}<form method="get"><div class="filters">{% for filter in collection.filters %}<details><summary>{{ filter.label }}</summary>{% case filter.type %}{% when 'list','boolean' %}<ul>{% for value in filter.values %}<li><label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}> {{ value.label | escape }} ({{ value.count }})</label></li>{% endfor %}</ul>{% when 'price_range' %}<label>Min <input class="input" name="{{ filter.min_value.param_name }}" type="number" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"></label><label>Max <input class="input" name="{{ filter.max_value.param_name }}" type="number" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"></label>{% endcase %}</details>{% endfor %}</div><button type="submit" class="button secondary">Apply filters</button> <a href="{{ collection.url }}">Clear</a></form>{% endif %}<div class="grid" style="margin-top:28px">{% for product in collection.products %}{% render 'product-card', card_product: product %}{% else %}<p>No products found</p>{% endfor %}</div><div class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}{{ paginate.current_page }} / {{ paginate.pages }}{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</div>{% endpaginate %}</div></section>{% schema %}{"name":"Collection products","settings":[{"type":"range","id":"per_page","label":"Products per page","min":8,"max":48,"step":4,"default":24},{"type":"checkbox","id":"filters","label":"Enable filters","default":true}]}{% endschema %}