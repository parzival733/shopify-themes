<section class="section"><div class="container product-grid"><div class="gallery">{% for media in product.media %}{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,750,1100,1400' }}{% when 'video' %}{{ media | video_tag: controls: true }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}{% endcase %}{% endfor %}</div><div class="product-info"><h1>{{ product.title | escape }}</h1>{% assign v = product.selected_or_first_available_variant %}<p><strong data-price>{{ v.price | money }}</strong>{% if v.compare_at_price > v.price %} <s>{{ v.compare_at_price | money }}</s>{% endif %}</p>{% if v.unit_price_measurement %}<small>{{ v.unit_price | unit_price_with_measurement: v.unit_price_measurement }}</small>{% endif %}{% for block in section.blocks %}{% case block.type %}{% when 'description' %}<div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{% when 'buy' %}<div {{ block.shopify_attributes }}>{% form 'product', product, data-product-form: '' %}<input type="hidden" name="id" value="{{ v.id }}">{% unless product.has_only_default_variant %}<div class="field"><label for="Variants">Options</label><select class="input" id="Variants" data-variant>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}"{% if variant.id == v.id %} selected{% endif %}>{{ variant.title | escape }}</option>{% endfor %}</select></div>{% endunless %}{% if product.selling_plan_groups.size > 0 %}<div class="field"><label for="SellingPlan">Purchase option</label><select class="input" name="selling_plan" id="SellingPlan"><option value="">One-time purchase</option>{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select></div>{% endif %}<div class="field"><label for="Quantity">Quantity</label><input class="input" style="max-width:130px" id="Quantity" name="quantity" type="number" min="{{ v.quantity_rule.min | default: 1 }}" step="{{ v.quantity_rule.increment | default: 1 }}" value="{{ v.quantity_rule.min | default: 1 }}"></div><button type="submit" class="button" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Add to cart{% else %}Sold out{% endif %}</button>{% if block.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}{% endform %}</div>{% when 'collapsible' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary>{{ block.settings.content }}</details>{% when '@app' %}{% render block %}{% endcase %}{% endfor %}</div></div></section><script type="application/ld+json">{{ product | structured_data }}</script>{% schema %}{"name":"Product information","blocks":[{"type":"description","name":"Description","limit":1},{"type":"buy","name":"Buy buttons","limit":1,"settings":[{"type":"checkbox","id":"dynamic_checkout","label":"Show accelerated checkout","default":true}]},{"type":"collapsible","name":"Collapsible panel","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shipping & returns"},{"type":"richtext","id":"content","label":"Content"}]},{"type":"@app"}]}{% endschema %}