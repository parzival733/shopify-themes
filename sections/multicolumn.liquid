<section class="section"><div class="container"><h2>{{ section.settings.heading | escape }}</h2><div class="grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="card-media" style="aspect-ratio:4/3">{% if block.settings.image %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% endif %}</div><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.body }}</div>{% if block.settings.link != blank %}<p><a href="{{ block.settings.link }}">{{ block.settings.link_text | escape }}</a></p>{% endif %}</article>{% endfor %}</div></div></section>{% schema %}{"name":"Multicolumn","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why shop with us"}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"A thoughtful detail"},{"type":"richtext","id":"body","label":"Description","default":"<p>Add your verified brand benefits here.</p>"},{"type":"text","id":"link_text","label":"Link text","default":"Learn more"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Multicolumn","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}{% endschema %}