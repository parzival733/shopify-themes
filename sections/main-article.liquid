<article class="section"><div class="container" style="max-width:850px"><a href="{{ blog.url }}">← {{ blog.title }}</a><h1>{{ article.title | escape }}</h1><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager' }}{% endif %}<div class="rte">{{ article.content }}</div></div></article>{% schema %}{"name":"Article","settings":[]}{% endschema %}