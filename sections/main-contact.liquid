<section class="section"><div class="container" style="max-width:800px"><h1>{{ page.title | default: 'Contact' | escape }}</h1>{{ page.content }}{% form 'contact' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Message sent.</p>{% endif %}<div class="field"><label for="ContactName">Name</label><input id="ContactName" class="input" name="contact[name]"></div><div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" class="input" name="contact[email]" required></div><div class="field"><label for="ContactBody">Message</label><textarea id="ContactBody" class="input" name="contact[body]" rows="6" required></textarea></div><button class="button">Send</button>{% endform %}</div></section>{% schema %}{"name":"Contact form","settings":[]}{% endschema %}