<section class="section"><div class="container" style="max-width:850px"><h1>Cart</h1>{% if cart.item_count == 0 %}<p>Your cart is empty.</p>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p><label>Quantity <input type="number" class="input" name="updates[]" min="0" value="{{ item.quantity }}"></label><a href="{{ item.url_to_remove }}">Remove</a></div></div>{% endfor %}<p>Subtotal: {{ cart.total_price | money }}</p><button type="submit" name="update" class="button secondary">Update cart</button> <button type="submit" name="checkout" class="button">Checkout</button></form>{% endif %}</div></section>{% schema %}{"name":"Cart","settings":[]}{% endschema %}