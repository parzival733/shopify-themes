<section class="section"><div class="container"><h1>Search</h1><form action="{{ routes.search_url }}" method="get" role="search" class="predictive" data-predictive><label for="SearchInput">Search products</label><input id="SearchInput" class="input" name="q" type="search" value="{{ search.terms | escape }}" autocomplete="off"><input type="hidden" name="type" value="product"><button class="button">Search</button><div class="predictive-results" data-predictive-results></div></form>{% if search.performed %}<h2>Results</h2>{% paginate search.results by 24 %}<div class="grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', card_product: item %}{% else %}<p><a href="{{ item.url }}">{{ item.title | escape }}</a></p>{% endif %}{% else %}<p>No results found.</p>{% endfor %}</div><div class="pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}{{ paginate.current_page }} / {{ paginate.pages }}{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</div>{% endpaginate %}{% endif %}</div></section>{% schema %}{"name":"Search","settings":[]}{% endschema %}