<header class="header{% if section.settings.sticky %} sticky{% endif %}"><div class="container header-inner"><a class="logo" href="{{ routes.root_url }}">{% if section.settings.logo %}{{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'eager', alt: shop.name, style: 'width:160px' }}{% else %}{{ shop.name }}{% endif %}</a><nav aria-label="Main navigation"><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></nav><div><a href="{{ routes.search_url }}">Search</a> · <a href="{{ routes.cart_url }}" data-open-cart>Cart (<span data-count>{{ cart.item_count }}</span>)</a></div></div><details class="container" style="padding-bottom:10px"><summary>Menu</summary><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul></details></header>{% schema %}{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Navigation","default":"main-menu"},{"type":"checkbox","id":"sticky","label":"Sticky header","default":true}]}{% endschema %}