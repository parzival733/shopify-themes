<section class="section faq"><div class="container" style="max-width:850px"><h2>{{ section.settings.heading | escape }}</h2>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</div></section>{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How does shipping work?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>See our shipping policy.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"}]}]}{% endschema %}