<section class="section"><div class="container"><h2>{{ section.settings.heading | escape }}</h2><div class="grid">{% for block in section.blocks %}{% assign c = block.settings.collection %}<a href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="card-media">{% if c.featured_image %}{{ c.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ c.title | default: 'Collection' }}</h3></a>{% endfor %}</div></div></section>{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore categories"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"}]}],"presets":[{"name":"Collection list","blocks":[{"type":"collection"},{"type":"collection"}]}]}{% endschema %}