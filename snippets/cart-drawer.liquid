<aside class="drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Shopping cart"><button class="drawer-back" data-close aria-label="Close cart"></button><div class="drawer-panel"><div style="display:flex;justify-content:space-between"><h2>Cart</h2><button data-close type="button">Close ×</button></div><div class="drawer-items" data-items data-empty="Your cart is empty"></div><div><p>Subtotal: <strong data-subtotal>{{ cart.total_price | money }}</strong></p><p class="muted">Shipping calculated at checkout</p><a class="button" href="{{ routes.cart_url }}">View cart</a> <form action="{{ routes.cart_url }}" method="post"><button class="button" type="submit" name="checkout">Checkout</button></form></div></div></aside><span class="visually-hidden" id="CartStatus" role="status" aria-live="polite"></span>