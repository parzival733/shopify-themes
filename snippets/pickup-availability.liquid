{% if product.selected_or_first_available_variant.store_availabilities.size > 0 %}<div class="section" style="padding-block:24px"><h3>In-store pickup</h3>{% for availability in product.selected_or_first_available_variant.store_availabilities %}<p>{% if availability.available %}Available{% else %}Unavailable{% endif %} at {{ availability.location.name | escape }}{% if availability.available and availability.pick_up_time != blank %} · {{ availability.pick_up_time }}{% endif %}</p>{% endfor %}</div>{% endif %}