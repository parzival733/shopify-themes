<article class="card"><a href="{{ card_product.url }}" class="card-media">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,750,900', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3><p>{{ card_product.price | money }} {% if card_product.compare_at_price > card_product.price %}<span class="price-old">{{ card_product.compare_at_price | money }}</span>{% endif %}</p>{% if card_product.selected_or_first_available_variant.unit_price_measurement %}<small>{{ card_product.selected_or_first_available_variant.unit_price | unit_price_with_measurement: card_product.selected_or_first_available_variant.unit_price_measurement }}</small>{% endif %}{% if card_product.available and settings.quick_add %}{% if card_product.has_only_default_variant %}<button type="button" class="button secondary" data-quick="{{ card_product.selected_or_first_available_variant.id }}">Add to cart</button>{% else %}<a class="button secondary" href="{{ card_product.url }}">Select options</a>{% endif %}{% endif %}</article>