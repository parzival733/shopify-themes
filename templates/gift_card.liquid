<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ gift_card.product.title | escape }} — {{ shop.name | escape }}</title>{{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body><main class="section"><div class="container" style="max-width:720px;text-align:center"><a href="{{ shop.url }}">{{ shop.name | escape }}</a><h1>{{ gift_card.product.title | escape }}</h1><p>{{ gift_card.initial_value | money_with_currency }}</p>{% if gift_card.expired or gift_card.enabled == false %}<p role="status">This gift card is no longer valid.</p>{% endif %}{% if gift_card.image %}{{ gift_card.image | image_url: width: 900 | image_tag: loading: 'eager' }}{% endif %}<p>Use this code at checkout:</p><p><strong id="GiftCardCode" style="font-size:clamp(22px,5vw,34px);overflow-wrap:anywhere">{{ gift_card.code | format_code }}</strong></p><p>Balance: {{ gift_card.balance | money_with_currency }}</p>{% if gift_card.expires_on %}<p>Expires: {{ gift_card.expires_on | date: '%d %B %Y' }}</p>{% endif %}<div>{{ gift_card | gift_card_qr_code }}</div><p><a class="button" href="{{ shop.url }}">Continue shopping</a> <button class="button secondary" type="button" onclick="window.print()">Print</button></p></div></main></body></html>